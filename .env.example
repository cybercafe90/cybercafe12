# Public browser configuration only. These values are safe to expose in the built client.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional PostHog web analytics. Add both values to Cloudflare Pages build environment.
VITE_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
VITE_POSTHOG_HOST=https://YOUR_REGION.i.posthog.com
