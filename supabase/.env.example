# Set these as Supabase Edge Function secrets; do not commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
TRACK_RATE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
RESEND_API_KEY=re_REPLACE_WITH_PROVIDER_KEY
EMAIL_FROM=BABA'S CYBER CAFE <support@babacybercafe.in>
BUSINESS_NOTIFICATION_EMAIL=support@babacybercafe.in
ALLOWED_ORIGINS=https://babacybercafe.in,https://www.babacybercafe.in,http://localhost:5173

# API Express: configure these as Edge Function secrets; never expose them to the browser.
APIEXPRESS_API_KEY=REPLACE_WITH_PROVIDER_KEY
APIEXPRESS_BASE_URL=https://sandbox.api.apiexpress.in
APIEXPRESS_FREE_CALL_LIMIT=1000
# Set this to provider dashboard usage already consumed in the current billing month before production calls.
APIEXPRESS_MONTHLY_USAGE_OFFSET=0
